{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Public endpoints up",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(probe_success{job=\"public-endpoints\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 6}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
    },
    {
      "title": "OKE nodes ready",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A"}],
      "fieldConfig": {"defaults": {"decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 2}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "title": "API request rate",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "sum(rate(localshops_http_requests_total{route!~\"/health/.*\"}[$__rate_interval])) or vector(0)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
    },
    {
      "title": "API 5xx percentage",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 * sum(rate(localshops_http_requests_total{status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(localshops_http_requests_total[$__rate_interval])), 0.001)", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "title": "Public endpoint response time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "probe_duration_seconds{job=\"public-endpoints\"}", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
    },
    {
      "title": "API request rate by status",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "sum(rate(localshops_http_requests_total{status_code=~\"2..\"}[$__rate_interval]))", "legendFormat": "2xx", "refId": "A"},
        {"expr": "sum(rate(localshops_http_requests_total{status_code=~\"4..\"}[$__rate_interval]))", "legendFormat": "4xx", "refId": "B"},
        {"expr": "sum(rate(localshops_http_requests_total{status_code=~\"5..\"}[$__rate_interval]))", "legendFormat": "5xx", "refId": "C"}
      ],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
    },
    {
      "title": "OKE node CPU usage",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",cluster=\"localshops-oke\"}[5m])))", "legendFormat": "{{instance}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}
    },
    {
      "title": "Recent API errors",
      "type": "logs",
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{namespace=~\"localshops(-dev)?\", app=\"api\"} |~ \"(?i)(error|exception|traceback|\\\" [45][0-9]{2} )\"", "refId": "A"}],
      "options": {"showTime": true, "showLabels": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["localshops", "sre", "production"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Localshops production overview",
  "uid": "localshops-production-overview",
  "version": 1
}
