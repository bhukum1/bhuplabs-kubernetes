[Unit]
Description=Localshops Alertmanager
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/localshops-observability

[Container]
Image=quay.io/prometheus/alertmanager@sha256:27c475db5fb156cab31d5c18a4251ac7ed567746a2483ff264516437a39b15ba
ContainerName=localshops-alertmanager
Network=host
Volume=/etc/localshops-observability/alertmanager/config.yml:/etc/alertmanager/config.yml:ro,Z
Volume=/etc/localshops-observability/alertmanager-smtp-password:/etc/alertmanager/smtp-password:ro,Z
Volume=/srv/localshops-observability/alertmanager:/alertmanager:Z
Exec=--config.file=/etc/alertmanager/config.yml --storage.path=/alertmanager --web.listen-address=127.0.0.1:9093 --cluster.listen-address= --data.retention=120h

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
MemoryMax=256M

[Install]
WantedBy=multi-user.target
