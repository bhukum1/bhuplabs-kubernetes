[Unit]
Description=Localshops Blackbox Exporter
After=network-online.target
Wants=network-online.target

[Container]
Image=quay.io/prometheus/blackbox-exporter@sha256:88f7d7397ad4cf415b575df60c937fef09e0534cb8a3e060bedff6e61da9e613
ContainerName=localshops-blackbox
Network=host
Volume=/etc/localshops-observability/blackbox/config.yml:/etc/blackbox/config.yml:ro,Z
Exec=--config.file=/etc/blackbox/config.yml --web.listen-address=127.0.0.1:9115

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
MemoryMax=128M

[Install]
WantedBy=multi-user.target
