[Unit]
Description=Localshops Grafana
After=network-online.target localshops-victoriametrics.service localshops-loki.service
Requires=localshops-victoriametrics.service localshops-loki.service
RequiresMountsFor=/srv/localshops-observability

[Container]
Image=docker.io/grafana/grafana@sha256:c3a47b8f5c031482ba3ae8212d18ca32dcf69cecac34668897420d5a3146a6c9
ContainerName=localshops-grafana
Network=host
Entrypoint=/usr/share/grafana/bin/grafana
Exec=server --homepath=/usr/share/grafana --config=/etc/grafana/grafana.ini --packaging=docker cfg:default.log.mode=console cfg:default.paths.data=/var/lib/grafana cfg:default.paths.logs=/var/log/grafana cfg:default.paths.plugins=/var/lib/grafana/plugins cfg:default.paths.provisioning=/etc/grafana/provisioning
EnvironmentFile=/etc/localshops-observability/grafana.env
Environment=HOME=/usr/share/grafana
Environment=GF_SERVER_HTTP_ADDR=127.0.0.1
Environment=GF_SERVER_HTTP_PORT=3000
Environment=GF_SERVER_ROOT_URL=https://grafana.bhuplabs.dev
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_SECURITY_COOKIE_SECURE=true
Environment=GF_SECURITY_COOKIE_SAMESITE=strict
Environment=GF_SECURITY_DISABLE_GRAVATAR=true
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_LOG_MODE=console
Volume=/srv/localshops-observability/grafana:/var/lib/grafana:Z
Volume=/etc/localshops-observability/grafana/provisioning:/etc/grafana/provisioning:ro,Z
Volume=/etc/localshops-observability/grafana/dashboards:/var/lib/grafana/dashboards:ro,Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900
MemoryMax=768M

[Install]
WantedBy=multi-user.target
