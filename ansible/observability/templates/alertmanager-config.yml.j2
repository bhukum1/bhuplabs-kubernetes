global:
  resolve_timeout: 5m
  smtp_smarthost: {{ alertmanager_smtp.smarthost | to_json }}
  smtp_from: {{ alertmanager_smtp.from | to_json }}
  smtp_auth_username: {{ alertmanager_smtp.auth_username | to_json }}
  smtp_auth_password_file: /etc/alertmanager/smtp-password
  smtp_require_tls: true

route:
  receiver: production-alerts
  group_by:
    - alertname
    - environment
    - service
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: development-alerts
      matchers:
        - environment=~"development|legacy"
      repeat_interval: 24h
    - receiver: production-alerts
      matchers:
        - severity="critical"
      repeat_interval: 1h

receivers:
  - name: production-alerts
    email_configs:
      - to: {{ alertmanager_smtp.to | to_json }}
        send_resolved: true
        headers:
          Subject: '{% raw %}[DUKLY PROD][{{ .Status | toUpper }}][{{ .CommonLabels.severity | toUpper }}] {{ .CommonAnnotations.summary }}{% endraw %}'
  - name: development-alerts
    email_configs:
      - to: {{ alertmanager_smtp.to | to_json }}
        send_resolved: true
        headers:
          Subject: '{% raw %}[DUKLY DEV][{{ .Status | toUpper }}][{{ .CommonLabels.severity | toUpper }}] {{ .CommonAnnotations.summary }}{% endraw %}'

inhibit_rules:
  - source_matchers:
      - severity="critical"
    target_matchers:
      - severity="warning"
    equal:
      - alertname
      - environment
      - service
