#!/usr/bin/env bash
set -euo pipefail

readonly pid_file="${HOME}/.local/state/localshops-oke/tunnel.pid"
readonly kubeconfig_file="${HOME}/.kube/config"

if [[ ! -s "${pid_file}" ]] || ! kill -0 "$(<"${pid_file}")" 2>/dev/null; then
  echo "OKE tunnel is not running."
  exit 1
fi

echo "OKE tunnel is running (PID $(<"${pid_file}"))."
kubectl --kubeconfig "${kubeconfig_file}" get nodes
