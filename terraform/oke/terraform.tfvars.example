# Copy to terraform.tfvars only for local planning. Never commit the copy.
tenancy_ocid      = "ocid1.tenancy.oc1..replace-me"
compartment_ocid  = "ocid1.compartment.oc1..replace-me"
region            = "us-ashburn-1"
home_region       = "us-ashburn-1"
kubernetes_version = "v1.36.1"
ssh_public_key    = "ssh-ed25519 AAAA... localshops-operator"

cluster_name                = "localshops-production"
environment                 = "production"
